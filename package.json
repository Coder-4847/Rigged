{
  "name": "rigged",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "levels": "tsx scripts/gen-levels.ts",
    "validate": "tsx scripts/validate-levels.ts",
    "smoke": "tsx scripts/smoke.ts --strict",
    "feel": "tsx scripts/feel.ts",
    "test": "npm run feel && npm run hazards && npm run save && npm run input && npm run validate && npm run smoke",
    "hazards": "tsx scripts/hazards.ts",
    "save": "tsx scripts/save.ts",
    "input": "tsx scripts/input.ts"
  },
  "dependencies": {
    "planck": "^1.4.2",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}